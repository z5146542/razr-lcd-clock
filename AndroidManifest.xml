<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="dev.lcdclock"
    android:versionCode="1"
    android:versionName="1.0">

    <uses-sdk android:minSdkVersion="33" android:targetSdkVersion="35" />

    <!-- Cover-screen timer: exact alarm, ringing service, stop notification. -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Battery saver and Night Light tiles; only grantable over adb (QuickControls.canWriteSecure). -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- RECORDER, CALENDAR and WEATHER pages on the outside screen. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Recordings: Fossify Voice Recorder's, in Recordings, besides LCD Clock's own. -->
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />

    <!-- TIMER: start timers in Google Clock (SET_TIMER). -->

    <!-- Quick controls: whether a VPN (WireGuard) is up. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- App names for the outside screen's MUSIC tabs, one per app playing. -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <!-- Home Assistant's REST API (HTTPS only), for the HOME buttons' on/off state. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- The Home Assistant app, whose Button widget the volume-up hold presses. -->
    <queries>
        <package android:name="io.homeassistant.companion.android" />
    </queries>

    <!-- Whether a banking app is still running as the phone closes, so the cover button stays off
         (BankApps): usage access for when it was used, DUMP for when its process died. install.sh
         allows both over adb. -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" />
    <uses-permission android:name="android.permission.DUMP" />

    <!-- Re-arm the alarm after a reboot. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:label="@string/app_name"
        android:icon="@drawable/ic_launcher"
        android:allowBackup="false">

        <!-- Motorola allowlist for the small cover screen; without it display 1 is invisible to the app. -->
        <meta-data
            android:name="com.motorola.allow_activities_on_small_external_display"
            android:value="true" />

        <activity
            android:name=".PreviewActivity"
            android:exported="true"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!-- The recordings, on the inside screen: from the Recorder card or the launcher shortcut. -->
        <activity
            android:name=".RecordingsActivity"
            android:label="@string/recordings_title"
            android:exported="true"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar" />


        <!-- Hold volume-down with the phone closed to open Alarm & Timer on the cover display. -->
        <service
            android:name=".ButtonService"
            android:label="@string/button_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/button_service" />
        </service>

        <!-- Notification access: lets the MUSIC page see and control the music that's playing. -->
        <service
            android:name=".MediaListener"
            android:label="@string/media_listener_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <activity
            android:name=".CoverActivity"
            android:exported="false"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:launchMode="singleTask"
            android:taskAffinity="dev.lcdclock.cover"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar.Fullscreen" />

        <!-- A moment of black landscape, so the inner screen turns and PiP comes back on-screen (PipGuard). -->
        <activity
            android:name=".PipResetActivity"
            android:exported="false"
            android:screenOrientation="landscape"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize"
            android:taskAffinity="dev.lcdclock.pipreset"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@style/PipReset" />

        <!-- The home screen clock widgets: the face, and the time alone. -->
        <receiver
            android:name=".ClockWidget"
            android:exported="true"
            android:label="@string/widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/clock_widget" />
        </receiver>
        <receiver
            android:name=".TimeWidget"
            android:exported="true"
            android:label="@string/time_widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/time_widget" />
        </receiver>
        <!-- The cover button's state and switch (ButtonPause): a home screen widget and a quick settings tile. -->
        <receiver
            android:name=".ButtonWidget"
            android:exported="true"
            android:label="@string/button_widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/button_widget" />
        </receiver>
        <receiver android:name=".ButtonWidget$Toggle" android:exported="false" />
        <service
            android:name=".ButtonTile"
            android:exported="true"
            android:label="@string/tile_label"
            android:icon="@drawable/ic_tile_button"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
        <receiver android:name=".TimerReceiver" android:exported="false" />
        <receiver android:name=".AlarmReceiver" android:exported="false" />
        <receiver
            android:name=".RescheduleReceiver"
            android:exported="false"
            android:directBootAware="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>

        <service
            android:name=".RecorderService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <service
            android:name=".RingService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!-- SOS with the flashlight: keeps signalling with the screen off. -->
        <service
            android:name=".SosService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Flashes SOS in Morse code with the flashlight until the user stops it." />
        </service>

        <!-- Motorola clock face plugin: discovery, session and options (see MotoClockFace). -->
        <service
            android:name=".LcdClockService"
            android:permission="com.motorola.permission.BIND_CLOCK_FACE_SERVICE"
            android:exported="true"
            android:directBootAware="true">
            <intent-filter>
                <action android:name="com.motorola.service.action.CLOCK_FACE_SERVICE" />
            </intent-filter>
            <meta-data
                android:name="com.motorola.clockface_service"
                android:resource="@xml/clock_face_service" />
        </service>

        <service
            android:name=".LcdSessionService"
            android:permission="com.motorola.permission.BIND_CLOCK_FACE_SERVICE"
            android:exported="true"
            android:directBootAware="true">
            <intent-filter>
                <action android:name="com.motorola.service.action.CLOCK_FACE_SESSION_SERVICE" />
            </intent-filter>
        </service>

        <provider
            android:name=".LcdOptionsProvider"
            android:authorities="dev.lcdclock.clockface-options"
            android:readPermission="com.motorola.permission.READ_CLOCK_FACE_OPTIONS"
            android:exported="true"
            android:directBootAware="true">
            <intent-filter>
                <action android:name="com.motorola.clockface.action.CLOCK_FACE_OPTIONS" />
            </intent-filter>
        </provider>
    </application>
</manifest>
