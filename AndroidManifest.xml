<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="dev.lcdclock"
    android:versionCode="1"
    android:versionName="1.0">

    <uses-sdk android:minSdkVersion="33" android:targetSdkVersion="35" />

    <!-- Cover-screen timer: exact alarm, ringing service, stop notification. -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- RECORDER, CALENDAR and WEATHER pages on the outside screen. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Recordings: Fossify Voice Recorder's, in Recordings, besides LCD Clock's own. -->
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />

    <!-- TIMER: start timers in Google Clock (SET_TIMER). -->

    <!-- Quick controls: whether a VPN (WireGuard) is up. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- App names for the outside screen's MUSIC tabs, one per app playing. -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <!-- Home Assistant's REST API, for the HOME buttons' on/off state. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- The Home Assistant app, whose Button widget the volume-up hold presses. -->
    <queries>
        <package android:name="io.homeassistant.companion.android" />
    </queries>

    <!-- Re-arm the alarm after a reboot. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:label="@string/app_name"
        android:icon="@drawable/ic_launcher"
        android:allowBackup="false"
        android:usesCleartextTraffic="true">

        <!-- Motorola allowlist for the small cover screen; without it display 1 is invisible to the app. -->
        <meta-data
            android:name="com.motorola.allow_activities_on_small_external_display"
            android:value="true" />

        <activity
            android:name=".PreviewActivity"
            android:exported="true"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!-- The recordings, on the inside screen: from the Recorder card or the launcher shortcut. -->
        <activity
            android:name=".RecordingsActivity"
            android:label="@string/recordings_title"
            android:exported="true"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar" />


        <!-- Hold volume-down with the phone closed to open Alarm & Timer on the cover display. -->
        <service
            android:name=".ButtonService"
            android:label="@string/button_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/button_service" />
        </service>

        <!-- Notification access: lets the MUSIC page see and control the music that's playing. -->
        <service
            android:name=".MediaListener"
            android:label="@string/media_listener_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <activity
            android:name=".CoverActivity"
            android:exported="false"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:launchMode="singleTask"
            android:taskAffinity="dev.lcdclock.cover"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar.Fullscreen" />

        <receiver android:name=".TimerReceiver" android:exported="false" />
        <receiver android:name=".AlarmReceiver" android:exported="false" />
        <receiver
            android:name=".RescheduleReceiver"
            android:exported="false"
            android:directBootAware="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>

        <service
            android:name=".RecorderService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <service
            android:name=".RingService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!-- Motorola clock face plugin: discovery, session and options (see MotoClockFace). -->
        <service
            android:name=".LcdClockService"
            android:permission="com.motorola.permission.BIND_CLOCK_FACE_SERVICE"
            android:exported="true"
            android:directBootAware="true">
            <intent-filter>
                <action android:name="com.motorola.service.action.CLOCK_FACE_SERVICE" />
            </intent-filter>
            <meta-data
                android:name="com.motorola.clockface_service"
                android:resource="@xml/clock_face_service" />
        </service>

        <service
            android:name=".LcdSessionService"
            android:permission="com.motorola.permission.BIND_CLOCK_FACE_SERVICE"
            android:exported="true"
            android:directBootAware="true">
            <intent-filter>
                <action android:name="com.motorola.service.action.CLOCK_FACE_SESSION_SERVICE" />
            </intent-filter>
        </service>

        <provider
            android:name=".LcdOptionsProvider"
            android:authorities="dev.lcdclock.clockface-options"
            android:readPermission="com.motorola.permission.READ_CLOCK_FACE_OPTIONS"
            android:exported="true"
            android:directBootAware="true">
            <intent-filter>
                <action android:name="com.motorola.clockface.action.CLOCK_FACE_OPTIONS" />
            </intent-filter>
        </provider>
    </application>
</manifest>
